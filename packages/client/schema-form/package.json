{
  "name": "@ikun-ai/dsh-client-schema-form",
  "description": "Schema/draft model layer for settings editors: rehydrates a serialized schemastery schema, validates drafts, and edits them immutably by path",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laowangyiyunle/ikun-ai.git",
    "directory": "packages/client/schema-form"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@ikun-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@ikun-ai/dsh-invariants": "workspace:^",
    "@ikun-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@ikun-ai/dsh-invariants": "workspace:^",
    "@ikun-ai/cordis": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ]
}
